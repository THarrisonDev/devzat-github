[Unit]
Description=Devzat GitHub plugin
Documentation=https://github.com/quackduck/devzat
After=network-online.target devzat.service
Wants=network-online.target devzat.service

[Service]
Type=simple
User=devzat
Group=devzat
EnvironmentFile=/etc/devzat-github.env
ExecStart=/usr/local/bin/devzat-github localhost:5556
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
